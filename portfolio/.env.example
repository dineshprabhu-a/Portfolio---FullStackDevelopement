# For local development, leave empty (Vite proxy handles /api → localhost:8080)
# For production, set to your Render backend URL
VITE_API_URL=
# Example: VITE_API_URL=https://portfolio-backend-xxxx.onrender.com

# Google reCAPTCHA v3 site key (get from https://www.google.com/recaptcha/admin)
VITE_RECAPTCHA_SITE_KEY=
